\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces CASES-99 benchmark simulation over a 12-hour nocturnal cycle: (a) Fast state dynamics displaying desingularized TKE ($\tilde  {e}$) and vertical heat flux ($q_\theta $); (b) Thermal evolution of skin temperature ($T_s$) and deep soil temperature ($T_g$); (c) 3D phase-space trajectory $(\tilde  {e}, q_\theta , S)$ relative to the fast critical manifold $\mathcal  {M}_0$ and fold locus $\mathcal  {C}_{\text  {fold}}$; (d) Evolution of the 2D fast Jacobian determinant $\det (J_{\text  {fast}})$, illustrating the loss of Fenichel normal hyperbolicity prior to turbulence collapse.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:cases99_manifold}{{1}{5}{CASES-99 benchmark simulation over a 12-hour nocturnal cycle: (a) Fast state dynamics displaying desingularized TKE ($\tilde {e}$) and vertical heat flux ($q_\theta $); (b) Thermal evolution of skin temperature ($T_s$) and deep soil temperature ($T_g$); (c) 3D phase-space trajectory $(\tilde {e}, q_\theta , S)$ relative to the fast critical manifold $\mathcal {M}_0$ and fold locus $\mathcal {C}_{\text {fold}}$; (d) Evolution of the 2D fast Jacobian determinant $\det (J_{\text {fast}})$, illustrating the loss of Fenichel normal hyperbolicity prior to turbulence collapse}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Fast subsystem phase-space trajectory projected onto $(\tilde  {e}, q_\theta )$ coordinates, demonstrating rapid fast-fiber relaxation toward the attractive critical manifold $\mathcal  {M}_0^+$ followed by slow evolutionary drift toward the non-hyperbolic fold boundary.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:manifold}{{2}{6}{Fast subsystem phase-space trajectory projected onto $(\tilde {e}, q_\theta )$ coordinates, demonstrating rapid fast-fiber relaxation toward the attractive critical manifold $\mathcal {M}_0^+$ followed by slow evolutionary drift toward the non-hyperbolic fold boundary}{figure.2}{}}
